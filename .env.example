# Copy to .env and replace every placeholder. Never commit .env.
ENVIRONMENT=prod
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080
# Optional override for the privacy-filtered log directory (default: data/logs).
TAFFY_LOG_DIR=
# Required in addition to strong OneBot credentials before using a non-loopback HOST.
# Set true only behind a trusted TLS reverse proxy or private TLS ingress.
TAFFY_INGRESS_TLS_TERMINATED=false
# Hostnames the listener may be addressed by, besides loopback names and
# literal IP addresses. A browser rebound onto 127.0.0.1 sends its own
# hostname and is refused; serving a DNS name here requires listing it, e.g.
# TAFFY_ALLOWED_HOSTS=bot.example.com. "*" disables the Host check entirely.
TAFFY_ALLOWED_HOSTS=

# OneBot V11: configure both before binding HOST to a non-loopback address.
ONEBOT_V11_SECRET=
ONEBOT_V11_ACCESS_TOKEN=
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]
SUPERUSERS=[]

# V4 official news/events and newly rebuilt market columns start with a
# three-day administrator pilot. Safety fixes remain active for every user.
TAFFY_V4_ENABLED=false
TAFFY_V4_FULL_ROLLOUT=false
TAFFY_V4_PILOT_USERS=[]
# Optional ISO-8601 deadline (e.g. 2026-08-10T00:00:00+08:00) after which the
# V4 pilot auto-expires until full rollout or an explicit extension.
TAFFY_V4_PILOT_UNTIL=

# Persona V3 stays owner-only until the seven-day pilot is accepted.
TAFFY_PERSONA_V3_ENABLED=false
TAFFY_PERSONA_V3_FULL_ROLLOUT=false
TAFFY_PERSONA_V3_PILOT_USERS=[]
TAFFY_PERSONA_REVIEW_ENABLED=true
TAFFY_PERSONA_REVIEW_TIMEOUT_SECONDS=8
TAFFY_PERSONA_REVIEW_PER_USER_MINUTE=2
TAFFY_PERSONA_REVIEW_GLOBAL_MINUTE=6

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset or weak, /api/admin remains disabled.
ADMIN_API_TOKEN=

# Taffy Desktop Studio (desktop/ shell) — fail-closed master switch for
# /api/desktop/*. Keep false unless the desktop app runs on this machine.
TAFFY_DESKTOP_API_ENABLED=false
# Owner QQ for desktop chat/persona/alerts. Falls back to the first superuser
# when unset; both missing disable those endpoints (semantic 503).
DESKTOP_OWNER_QQ=

TAFFY_API_KEY=
TAFFY_API_FORMAT=anthropic
# Use openai for an OpenAI-compatible Chat Completions endpoint; configure
# TAFFY_BASE_URL and TAFFY_MODEL for that same provider. Never mix protocols.
TAFFY_BASE_URL=https://api.deepseek.com/anthropic
TAFFY_ALLOW_INSECURE_HTTP_ENDPOINTS=false
TAFFY_MODEL=deepseek-v4-pro
# provider_default is safest for DeepSeek-compatible endpoints; set adaptive only
# for a Claude model/endpoint that officially supports it.
TAFFY_THINKING_MODE=provider_default
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
STEAMDT_API_KEY=
# V0.4 P3/P4 learning and expression switches (all fail-closed).
# Chat-history compression: off by default; whitelist pilot QQ ids (comma
# separated, empty = everyone once enabled). Summaries stay local per scope.
# TAFFY_HISTORY_COMPRESSION_ENABLED=false
# TAFFY_SUMMARY_PILOT_USERS=
# TAFFY_SUMMARY_DAILY_BUDGET=50
# Relationship familiarity bands (kill switch; derived from confirmed
# signals only, never chat content).
# TAFFY_RELATIONSHIP_ENABLED=true
# Slang auto-mining: proposes pending terms from word frequencies; explicit
# 塔菲学话 teaching works regardless.
# TAFFY_SLANG_AUTOMINE_ENABLED=false
# Sticker reactions: require an admin-curated data/stickers/ + manifest.json
# library; three extra gates (probability / cooldown / daily cap) apply.
# TAFFY_STICKERS_ENABLED=false
# TAFFY_STICKER_REPLY_PROBABILITY=0.15
# TAFFY_STICKER_COOLDOWN_SECONDS=600
# TAFFY_STICKER_DAILY_CAP=6
# Optional CSQAQ open-platform data (cross-platform compare / rent yield /
# global supply). Register at https://csqaq.com for a free API_TOKEN and bind
# your IP whitelist there. Left empty keeps every CSQAQ feature fail-closed
# and hidden.
CSQAQ_API_KEY=
# CSQAQ_BASE_URL=https://api.csqaq.com
# Upstream allows one request per second per IP; the adapter serialises calls
# and waits this long after each completion (do not lower below ~1.1).
# CSQAQ_MIN_INTERVAL_SECONDS=1.1
# Optional free structured CS2 tournament feed. Sent only in a Bearer header.
PANDASCORE_TOKEN=

# Transactional state (sessions, alerts, watchlists, schedule and deliveries).
TAFFY_STATE_DB=data/taffy.db
TAFFY_MARKET_CATALOG_DB=data/market_catalog.db
TAFFY_MARKET_CATALOG_MIN_ENTRIES=1000
TAFFY_MARKET_SAMPLE_POOL_SIZE=2500
TAFFY_MARKET_HISTORY_DB=data/market_history.db
TAFFY_TELEMETRY_DB=data/telemetry.db
TAFFY_AUTOMATIC_BACKUP_DIR=data/backups/automatic
# Read-only daily snapshots of every runtime .env* file (SHA-256 manifest).
TAFFY_CONFIG_BACKUP_DIR=data/config-backups
# Keep false in production; use scripts.migrate_state for existing schema upgrades.
TAFFY_ALLOW_AUTO_DB_MIGRATION=false

# General chat does not send messages to web search unless explicitly enabled.
ENABLE_AUTO_WEB_SEARCH=false
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=6
LLM_GLOBAL_REQUESTS_PER_MINUTE=30
LLM_TOTAL_TIMEOUT=90
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_HISTORY_CHARS=12000
HTTP_MAX_RESPONSE_BYTES=2000000

# Optional local assets and background worker settings.
TAFFY_VIDEO_DIR=
FFMPEG_PATH=
# Optional legacy volume-page collector. Keep off unless its display fields are needed.
TAFFY_ENABLE_CACHE_WARMER=false
TAFFY_SCRAPE_SCRIPT=scrape_steamdt.py
TAFFY_SCRAPE_WORKDIR=.
TAFFY_SCRAPE_TIMEOUT_SECONDS=45
TAFFY_STEAMDT_CACHE=steamdt_data.json
# Normal K-line commands render a fast local PNG. These settings cover the
# isolated browser fallback and explicit "K线高清" command.
TAFFY_KLINE_SCREENSHOT_TIMEOUT_SECONDS=45
TAFFY_KLINE_SCREENSHOT_TERMINATE_GRACE_SECONDS=5
TAFFY_KLINE_SCREENSHOT_CACHE_SECONDS=60
TAFFY_KLINE_SCREENSHOT_MAX_BYTES=5242880

# Durable delivery policy. Disabling scheduled broadcasts pauses queued retries.
TAFFY_BROADCAST_MAX_ATTEMPTS=8
TAFFY_BROADCAST_RETRY_BASE_SECONDS=30
TAFFY_BROADCAST_RETRY_MAX_SECONDS=3600
TAFFY_BROADCAST_RETRY_BATCH_SIZE=100
TAFFY_BROADCAST_SEND_CONCURRENCY=5
TAFFY_BROADCAST_SEND_TIMEOUT_SECONDS=20
TAFFY_BROADCAST_LEASE_SECONDS=180
TAFFY_BROADCAST_CATCHUP_MINUTES=180
TAFFY_BROADCAST_CATCHUP_MAX_SLOTS=10
TAFFY_ALERT_MAX_ATTEMPTS=8
TAFFY_ALERT_BATCH_SIZE=50
TAFFY_ALERT_CONCURRENCY=5
TAFFY_ALERT_SEND_TIMEOUT_SECONDS=20
TAFFY_ALERT_LEASE_SECONDS=180
# Polls SQLite every five minutes; each monitored account is network-checked only once daily.
TAFFY_INVENTORY_MONITOR_POLL_SECONDS=300
TAFFY_INVENTORY_MONITOR_MAX_ATTEMPTS=8
TAFFY_INVENTORY_MONITOR_MAX_TOTAL_ACCOUNTS=500
TAFFY_INVENTORY_MONITOR_MAX_TOTAL_SUBSCRIPTIONS=5000
# 囤货雷达：inspect→磨损(float)解析服务。留空=完全禁用（系统照常运行，锚点列为 NULL）；
# 配置后仅对新增物品查 float（增量），单 IP 每小时上限见 INVENTORY_FLOAT_HOURLY_LIMIT。
INVENTORY_FLOAT_API_BASE=
INVENTORY_FLOAT_HOURLY_LIMIT=60
# 囤货雷达 P1 邮箱旁路（QQ 推送语义不变，邮件为 best-effort 异步通道）。
# SMTP_HOST 留空=禁用；启用需同时配置 MAIL_TO。凭据只从环境变量读取，禁止写死。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Bounded SQLite retention maintenance (runs once per interval across workers).
TAFFY_MAINTENANCE_INTERVAL_SECONDS=3600
TAFFY_RETENTION_BATCH_SIZE=1000
TAFFY_DELIVERY_RETENTION_DAYS=30
TAFFY_FAILED_RETENTION_DAYS=90
TAFFY_JOB_RETENTION_DAYS=30
TAFFY_SESSION_RETENTION_DAYS=180
TAFFY_INVENTORY_EVENT_RETENTION_DAYS=90
TAFFY_INVENTORY_HISTORY_RETENTION_DAYS=180

# One-time legacy import source; live schedule changes are stored in SQLite.
TAFFY_SCHEDULE_CONFIG=

# Semi-automated learning (observations, daily reflection, forgetting curve).
TAFFY_LEARNING_ENABLED=true
TAFFY_LEARNING_ANALYZE_INTERVAL_SECONDS=21600
TAFFY_LEARNING_RETENTION_DAYS=180
TAFFY_REFLECTION_HOUR=3

# Proactive services (opt-in pushes). Default OFF: users must run the
# 早盘提醒 command and an administrator must enable the master switch.
TAFFY_PROACTIVE_ENABLED=false
TAFFY_PROACTIVE_DAILY_CAP=2
TAFFY_PROACTIVE_MORNING_HOUR=9

# ── V0.5 第三梯队：主动插话（群聊心流）─────────────────────────
# 默认关。开启后仍需群管理员执行「塔菲插话开」逐群 opt-in（默认全关）。
# 隐私边界：旁听消息只进每群内存环形缓冲（最近 8 条），重启即失，
# 绝不落盘（不写 session_messages/usage_log/学习观察）；磁盘上唯一
# 新增持久化是审计台账 group_pulse_log（只含群号/触发原因/指纹哈希）。
TAFFY_GROUP_PULSE_ENABLED=false
TAFFY_GROUP_PULSE_COOLDOWN_SECONDS=1800
TAFFY_GROUP_PULSE_DAILY_CAP=3

# 会话级浮点心境（默认关）。开启后每个会话（群/私聊）维护一对
# (valence, energy) 浮点：正面/负面消息事件推高，空闲指数衰减回中性；
# 只以「当前心境」一行注入表达层 prompt（不影响人格常驻区、不落盘、
# 不写记忆/学习存储、不含聊天原文）。重启即复位。
# 白名单纪律：TAFFY_MOOD_PILOT_USERS 留空时回退 SUPERUSERS。
TAFFY_MOOD_ENABLED=false
# TAFFY_MOOD_PILOT_USERS=1001,1002

# 娱乐图片目录（娱乐图片 命令从这里随机选取；未配置时回退到本机 ComfyUI 输出目录）
# TAFFY_IMAGE_DIR=D:\ComfyUI\output

# ── V0.5 工具循环（fail-closed 工具：行情/群史/记忆/表情包）────
# 默认关；开启后先走 pilot 白名单（回退 SUPERUSERS），全量需显式打开。
TAFFY_TOOLS_ENABLED=false
TAFFY_TOOLS_PILOT_USERS=
TAFFY_TOOLS_FULL_ROLLOUT=false
TAFFY_TOOL_MAX_ROUNDS=3

# ── V0.5 VLM 看图（便宜视觉模型当"眼睛"，描述注入聊天上下文）──
# 图片仅在功能开启时发往所选供应商；描述缓存本地，绝不发给聊天模型额外内容。
TAFFY_VISION_ENABLED=false
TAFFY_VISION_API_KEY=
TAFFY_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TAFFY_VISION_MODEL=glm-4v-flash
TAFFY_VISION_DAILY_BUDGET=100
TAFFY_VISION_TIMEOUT_SECONDS=20
TAFFY_VISION_MAX_IMAGE_BYTES=5242880

# ── V0.5 表情包二期（四维选图 + 待审核池）────────────────────
TAFFY_STICKER_SMART_SELECT_ENABLED=false
TAFFY_STICKER_AUTOCOLLECT_ENABLED=false

# ── V0.5 记忆升级（睡眠整理 + 写入决策）──────────────────────
TAFFY_MEMORY_CONSOLIDATION_ENABLED=false
TAFFY_MEMORY_WRITE_DECISION_ENABLED=false

# ── V0.5 人格条目与体检 ─────────────────────────────────────
TAFFY_PERSONA_WORLD_ENTRIES=true
TAFFY_PERSONA_AUDIT_ENABLED=false

# ── V0.5 第三供应商备胎（OpenAI 兼容；不配则不启用）──────────
TAFFY_BACKUP_LLM_API_KEY=
TAFFY_BACKUP_LLM_BASE_URL=https://api.siliconflow.cn
TAFFY_BACKUP_LLM_MODEL=

# ── V0.5 混合记忆检索（FTS5 trigram BM25 + 可选语义向量 + RRF）──
# 语义通道默认关；开启后仅对已脱敏的沉淀印象摘要向量化（绝不向量
# 化聊天原文），且先过 pilot 白名单（回退 SUPERUSERS）。embedding
# API 失败自动降级纯 FTS5，并在检索结果里注明所用通道。
TAFFY_MEMORY_SEMANTIC_ENABLED=false
TAFFY_MEMORY_SEMANTIC_PILOT_USERS=
TAFFY_EMBEDDING_API_KEY=
TAFFY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
TAFFY_EMBEDDING_MODEL=BAAI/bge-m3
TAFFY_EMBEDDING_DAILY_BUDGET=200
TAFFY_EMBEDDING_TIMEOUT_SECONDS=15

# ── V0.5 开箱EV 计算器（ByMykel/CSGO-API + Valve 官方掉率）────
# 元数据经 jsDelivr 镜像同步到本地缓存库（默认 7 天 TTL，懒同步）；
# 价格全部来自本地已校验 SteamDT 报价，缺价物品如实标注。
TAFFY_CASE_EV_ENABLED=true
TAFFY_CSGO_META_DB=data/csgo_meta.db
TAFFY_CASE_META_TTL_HOURS=168
TAFFY_CASE_META_TIMEOUT_SECONDS=90

# ── V0.5 窗口B 挂刀指数（SteamTradingSiteTracker / iflow.work 转储）────
# 免费数据源：api.iflow.work priority_archive（JSONL 转储，12 小时更新，
# 直连可达）。上游 dump 最新停在 2026-05-20（已停止更新），快照输出
# 如实标注存档天数。默认关闭；开启后懒同步到 data/hoard_index.db。
TAFFY_HOARD_INDEX_ENABLED=false
TAFFY_HOARD_INDEX_DB=data/hoard_index.db
TAFFY_HOARD_INDEX_TTL_HOURS=12
TAFFY_HOARD_INDEX_MAX_AGE_SECONDS=120
TAFFY_HOARD_INDEX_TIMEOUT_SECONDS=120
TAFFY_HOARD_INDEX_LIST_BASE=https://api.iflow.work/export
TAFFY_HOARD_INDEX_DOWNLOAD_BASE=https://api.iflow.work/export

# ── CSQAQ 快照积累（价差/租金/在售量逐日快照） ──
# 成功查询即记一行（good_id, 当日），独立库 data/csqaq_history.db，主库零迁移；
# 比价尾部出价差趋势行（≥2 快照才显示）。默认关闭。
TAFFY_CSQAQ_HISTORY_ENABLED=false
TAFFY_CSQAQ_HISTORY_DB=data/csqaq_history.db

# ── SteamDT 检视图（正/背/细节图，需先查到磨损） ──
# 上游 100/天；本站每日限量 + 每人每天 3 次（app_meta 账本，无迁移）。默认关闭。
TAFFY_INSPECT_ENABLED=false
TAFFY_INSPECT_DAILY_BUDGET=30
